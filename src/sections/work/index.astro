---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import TitleList from "../../components/TitleList.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { byOrder, isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("work");
for (const entry of all) assertReadableSlug(entry.id, "Roles");
const entries = byOrder(all.filter(isLive));
---

<Base title="Work" page="work" current="work" description="Paid work, most recent first.">
  <Section num="01" title="Work" />
  <CollectionIndex section="work" reserved={all.map((entry) => entry.id)} />
  <TitleList items={entries.map((entry) => ({ href: `/work/${entry.id}/`, title: entry.data.title }))} />
</Base>
