---
import type { CollectionEntry } from "astro:content";
import { hasNote } from "../lib/content";
import { formatRating, formatRead } from "../lib/dates";

interface Props {
  books: CollectionEntry<"reading">[];
}

const { books } = Astro.props;
---

<ol class="poster">
  {
    books.map((entry, index) => {
      const href = hasNote(entry) ? `/reading/${entry.id}/` : undefined;
      const number = String(index + 1).padStart(2, "0");
      return (
        <li>
          <span class="poster-no">{number}</span>
          <p class="poster-name">
            {href ? (
              <a class="poster-title" href={href}>
                {entry.data.title}
              </a>
            ) : (
              <span class="poster-title">{entry.data.title}</span>
            )}
            {entry.data.lang === "nl" && (
              <abbr class="lang" title="Dutch">NL</abbr>
            )}
          </p>
          <p class="poster-by">{entry.data.author}</p>
          <p class="poster-date">
            {formatRead(entry.data.read)}
            {entry.data.rating != null && <span class="poster-rate">{formatRating(entry.data.rating)}</span>}
          </p>
        </li>
      );
    })
  }
</ol>
