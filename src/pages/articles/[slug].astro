---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Pager from "../../components/Pager.astro";
import { articleCover, byArticleDate } from "../../lib/articles";
import { isLive, neighbours } from "../../lib/content";
import { formatRead } from "../../lib/dates";
import { assertReadableSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const all = await getCollection("articles");
  for (const entry of all) assertReadableSlug(entry.id, "Articles");
  return byArticleDate(all.filter(isLive)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const articles = byArticleDate((await getCollection("articles")).filter(isLive));
const { newer, older } = neighbours(articles, entry.id);
const cover = articleCover(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.summary || entry.data.title}
  page="entry articles"
  current="articles"
  ogType="article"
>
  <header class="article-head">
    <p class="kicker signal-links"><a href="/articles/">articles</a></p>
    <h1>{entry.data.title}</h1>
    <p class="article-meta">{formatRead(entry.data.date)}</p>
  </header>
  {
    cover && (
      <figure class="article-figure">
        <Image src={cover} alt="" widths={[720, 1200, 1600]} sizes="(min-width: 720px) 720px, 100vw" />
      </figure>
    )
  }
  <div class="prose article signal-links">
    <Content />
  </div>
  <div class="block signal-links">
    <Pager
      indexHref="/articles/"
      indexLabel="all articles"
      newer={newer ? { href: `/articles/${newer.id}/`, label: "newer" } : undefined}
      older={older ? { href: `/articles/${older.id}/`, label: "older" } : undefined}
    />
  </div>
</Base>
