---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import TitleList from "../../components/TitleList.astro";
import { byOrder, isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("blog");
for (const entry of all) assertReadableSlug(entry.id, "Posts");
const entries = byOrder(all.filter(isLive));
---

<Base title="Blog" page="blog" current="blog" description="Notes, newest first.">
  <Section num="08" title="Blog" />
  <TitleList items={entries.map((entry) => ({ href: `/blog/${entry.id}/`, title: entry.data.title }))} />
</Base>
