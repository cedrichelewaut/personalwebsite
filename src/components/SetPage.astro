---
import { render, type CollectionEntry } from "astro:content";
import Note from "../layouts/Note.astro";
import Pager from "./Pager.astro";
import { hasNote } from "../lib/content";
import type { SectionName } from "../lib/series";
import { sectionMeta } from "../site.sections";

interface Props {
  entry: CollectionEntry<"series">;
}

const numbers: Record<SectionName, string> = {
  work: "01",
  study: "02",
  projects: "03",
  reading: "05",
};

const indexLabel: Record<SectionName, string> = {
  work: "all work",
  study: "all study",
  projects: "all projects",
  reading: "all reading",
};

const indexHref: Record<SectionName, string> = {
  work: sectionMeta.work.href,
  study: sectionMeta.study.href,
  projects: sectionMeta.projects.href,
  reading: sectionMeta.bookshelf.href,
};

const { entry } = Astro.props;
const section = entry.data.section;
const { Content } = await render(entry);
---

<Note
  page={`entry ${section}`}
  current={section}
  section={numbers[section]}
  title={entry.data.title}
  description={entry.data.summary || entry.data.title}
  kickerHref={indexHref[section]}
  kicker={section}
  dek={entry.data.summary}
  mark={entry.data.code}
>
  {hasNote(entry) && <Content />}
  <Pager slot="pager" indexHref={indexHref[section]} indexLabel={indexLabel[section]} />
</Note>
