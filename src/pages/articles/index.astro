---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArticleCards from "../../components/ArticleCards.astro";
import { byArticleDate } from "../../lib/articles";
import { isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("articles");
for (const entry of all) assertReadableSlug(entry.id, "Articles");
const articles = byArticleDate(all.filter(isLive));
---

<Base title="Articles" page="articles" current="articles" description="Articles, newest first.">
  <div class="grid head">
    <div class="head-copy span-all">
      <h1>Articles</h1>
    </div>
  </div>
  <ArticleCards articles={articles} />
</Base>
