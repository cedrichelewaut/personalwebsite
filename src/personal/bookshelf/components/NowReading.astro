---
interface Props {
  title: string;
  author: string;
  url: string;
  lang?: "nl";
  level?: "h2" | "h3";
}

const { title, author, url, lang, level = "h2" } = Astro.props;
const Heading = level;
---

<section class="now">
  <Heading class="now-kicker">currently reading</Heading>
  <p class="now-title">
    {title}
    {lang === "nl" && <abbr class="lang" title="Dutch">NL</abbr>}
  </p>
  <p class="now-author">{author}</p>
  <p class="now-link"><a href={url}>goodreads</a></p>
</section>
