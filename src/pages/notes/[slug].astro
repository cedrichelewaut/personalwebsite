---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Pager from "../../components/Pager.astro";
import { isLive, neighbours } from "../../lib/content";
import { formatRead } from "../../lib/dates";

export async function getStaticPaths() {
  const notes = (await getCollection("notes")).filter(isLive);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const oldestFirst = (await getCollection("notes"))
  .filter(isLive)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const newestFirst = [...oldestFirst].reverse();
const { newer, older } = neighbours(newestFirst, entry.id);
---

<Base
  title={entry.data.title}
  description={entry.data.subtitle || entry.data.title}
  page="entry notes"
  current="notes"
  ogType="article"
>
  <header class="article-head">
    <p class="kicker signal-links"><a href="/notes/">notes</a></p>
    <h1>{entry.data.title}</h1>
    {entry.data.subtitle && <p class="article-meta">{entry.data.subtitle}</p>}
    {entry.data.date && <p class="article-meta">{formatRead(entry.data.date)}</p>}
  </header>
  {
    entry.data.image && (
      <figure class="article-figure">
        <img src={entry.data.image.src} alt={entry.data.image.alt} />
      </figure>
    )
  }
  <div class="prose article signal-links">
    <Content />
  </div>
  {
    entry.data.photos.length > 0 && (
      <div class="article-photos">
        {entry.data.photos.map((photo) => (
          <img src={photo.src} alt={photo.alt} />
        ))}
      </div>
    )
  }
  <div class="block signal-links">
    <Pager
      indexHref="/notes/"
      indexLabel="all notes"
      newer={newer ? { href: `/notes/${newer.id}/`, label: "newer" } : undefined}
      older={older ? { href: `/notes/${older.id}/`, label: "older" } : undefined}
    />
  </div>
</Base>
