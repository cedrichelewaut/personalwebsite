---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { hasNote, isLive } from "../../lib/content";
import { albumImages, byAlbumDate, collageRows, photoCaption } from "../../lib/photography";
import { assertReadableSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const all = await getCollection("photography");
  for (const entry of all) assertReadableSlug(entry.id, "Albums");
  return byAlbumDate(all.filter(isLive)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const rows = collageRows(albumImages(entry.id));
---

<Base title={entry.data.title} description={entry.data.title} page="entry photography" current="" ogType="article">
  <header class="article-head">
    <h1>{entry.data.title}</h1>
  </header>
  {
    hasNote(entry) && (
      <div class="prose article">
        <Content />
      </div>
    )
  }
  {
    rows.length > 0 && (
      <div class="collage">
        {rows.map((row) => (
          <div class:list={["collage-row", row.solo && "solo"]} style={row.solo ? `--r:${row.items[0].ratio}` : undefined}>
            {row.items.map((item) => (
              <figure class="frame" style={`--r:${item.ratio}`}>
                <Image
                  src={item.image}
                  alt=""
                  widths={[480, 720, 1080, 1600]}
                  sizes={`(min-width: 720px) ${Math.round(item.share * 100)}vw, 100vw`}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="frame-meta">{photoCaption(item.image) || "\u00a0"}</figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    )
  }
</Base>
