---
import { getCollection, render } from "astro:content";
import EntryArticle from "../../components/EntryArticle.astro";
import Pager from "../../components/Pager.astro";
import SetPage from "../../components/SetPage.astro";
import { byOrder, hasNote, isLive, neighbours } from "../../lib/content";
import { formatRange } from "../../lib/dates";
import { loadSeries } from "../../lib/series";
import { assertReadableSlug } from "../../lib/slugs";
import { sectionMeta } from "../../site.sections";

export async function getStaticPaths() {
  const all = await getCollection("projects");
  for (const entry of all) assertReadableSlug(entry.id, "Projects");
  const items = byOrder(all.filter(isLive));
  const sets = await loadSeries(
    "projects",
    all.map((entry) => entry.id),
  );
  return [
    ...items.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "item" as const, entry },
    })),
    ...sets.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "set" as const, entry },
    })),
  ];
}

const props = Astro.props;
const entry = props.kind === "item" ? props.entry : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const items = byOrder((await getCollection("projects")).filter(isLive));
const { newer, older } = entry ? neighbours(items, entry.id) : { newer: undefined, older: undefined };
const link = entry?.data.url?.trim() ?? "";
const dates =
  entry?.data.start && entry?.data.end ? formatRange(entry.data.start, entry.data.end) : "";
---

{
  props.kind === "set" && <SetPage entry={props.entry} />
}
{
  entry && (
    <EntryArticle
      page="entry projects"
      current="projects"
      title={entry.data.title}
      description={entry.data.summary}
      kickerHref={sectionMeta.projects.href}
      kicker="projects"
      meta={dates ? [dates] : []}
      image={entry.data.image}
      photos={entry.data.photos}
      link={link}
    >
      {hasNote(entry) && Content ? <Content /> : <p>{entry.data.summary}</p>}
      <Pager
        slot="pager"
        indexHref={sectionMeta.projects.href}
        indexLabel="all projects"
        newer={newer ? { href: `/projects/${newer.id}/`, label: "newer" } : undefined}
        older={older ? { href: `/projects/${older.id}/`, label: "older" } : undefined}
      />
    </EntryArticle>
  )
}
