---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import TitleList from "../../components/TitleList.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { byOrder, isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("projects");
for (const entry of all) assertReadableSlug(entry.id, "Projects");
const entries = byOrder(all.filter(isLive));
---

<Base title="Projects" page="projects" current="projects" description="Projects, most recent first.">
  <Section num="03" title="Projects" />
  <CollectionIndex section="projects" reserved={all.map((entry) => entry.id)} />
  <TitleList items={entries.map((entry) => ({ href: `/projects/${entry.id}/`, title: entry.data.title }))} />
</Base>
