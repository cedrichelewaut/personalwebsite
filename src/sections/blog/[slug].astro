---
import { getCollection, render } from "astro:content";
import Note from "../../layouts/Note.astro";
import { byOrder, hasNote, isLive } from "../../lib/content";
import { formatRead } from "../../lib/dates";
import { assertReadableSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const all = await getCollection("blog");
  for (const entry of all) assertReadableSlug(entry.id, "Posts");
  const posts = byOrder(all.filter(isLive));
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Note
  page="entry blog"
  title={entry.data.title}
  description={entry.data.summary || entry.data.title}
  meta={entry.data.noteDate ? [formatRead(entry.data.noteDate)] : []}
>
  {hasNote(entry) ? <Content /> : <p>{entry.data.summary}</p>}
</Note>
