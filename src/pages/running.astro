---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";

const board = "https://cedrichelewaut.github.io/marathoning/";
const progress = `${board}progress.html`;
const intro = "Currently training for Hamburg Marathon 2027. Progress so far:";
---

<Base title="Running" page="running" current="running" description={intro}>
  <Section num="06" title="Running">
    <p class="lede">{intro}</p>
    <iframe
      id="running-progress"
      class="progress-frame"
      src={progress}
      title="Marathon training progress"
      scrolling="no"
      loading="eager"
    ></iframe>
    <p class="lede">Training schema inspired by Advanced Marathoning (Pfitzinger & Douglas).</p>
    <p class="board-link signal-links">
      <a href={board} target="_blank" rel="noopener noreferrer">Open full board</a>
    </p>
  </Section>
  <script is:inline>
    (function () {
      var frame = document.getElementById("running-progress");
      if (!frame || !window.fetch) return;
      var src = frame.getAttribute("src");

      function fit(px) {
        if (!px || px < 48 || px > 480) return;
        var next = Math.ceil(px) + 2;
        if (Math.abs(frame.getBoundingClientRect().height - next) < 2) return;
        frame.style.height = next + "px";
      }

      function width() {
        return Math.round(frame.getBoundingClientRect().width);
      }

      window.addEventListener("message", function (event) {
        if (event.origin !== "https://cedrichelewaut.github.io" || event.source !== frame.contentWindow) return;
        var data = event.data;
        if (data && typeof data === "object" && typeof data.height === "number") fit(data.height);
      });

      fetch(src, { credentials: "omit" })
        .then(function (res) {
          if (!res.ok) return;
          return res.text();
        })
        .then(function (html) {
          if (!html || html.toLowerCase().indexOf("<" + "script") !== -1) return;
          var w = width();
          if (w < 160) return;
          var probe = document.createElement("iframe");
          probe.setAttribute("aria-hidden", "true");
          probe.setAttribute("sandbox", "allow-same-origin");
          probe.setAttribute("inert", "");
          probe.setAttribute("scrolling", "no");
          probe.tabIndex = -1;
          probe.title = "";
          probe.style.cssText =
            "position:fixed;left:0;top:0;visibility:hidden;pointer-events:none;border:0;height:40px;width:" +
            w +
            "px;";
          if (html.toLowerCase().indexOf("<base") === -1) {
            html = html.replace(/<head[^>]*>/i, function (tag) {
              return tag + '<base href="' + src + '">';
            });
          }
          probe.srcdoc = html;
          function measure() {
            var doc = probe.contentDocument;
            if (!doc) return;
            var root = doc.documentElement;
            var body = doc.body;
            fit(Math.max(root ? root.scrollHeight : 0, body ? body.scrollHeight : 0));
          }
          probe.addEventListener("load", function () {
            measure();
            var doc = probe.contentDocument;
            if (doc && doc.fonts && doc.fonts.ready) doc.fonts.ready.then(measure);
            if (doc && window.ResizeObserver) new ResizeObserver(measure).observe(doc.documentElement);
          });
          document.body.appendChild(probe);
          if (window.ResizeObserver) {
            new ResizeObserver(function () {
              var next = width();
              if (Math.abs(parseFloat(probe.style.width) - next) < 2) return;
              probe.style.width = next + "px";
            }).observe(frame);
          }
        })
        .catch(function () {});
    })();
  </script>
</Base>
