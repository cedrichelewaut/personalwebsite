---
import Base from "./Base.astro";

interface Props {
  page: string;
  title: string;
  description?: string;
  dek?: string;
  mark?: string;
  meta?: string[];
}

const { page, title, description, dek, mark, meta = [] } = Astro.props;
---

<Base title={title} description={description} page={page} current="" ogType="article">
  <header class="article-head">
    {mark && <p class="mark">{mark}</p>}
    <h1>{title}</h1>
    {dek && <p class="dek">{dek}</p>}
    {meta.map((line) => <p class="article-meta">{line}</p>)}
  </header>
  <div class="prose article signal-links">
    <slot />
  </div>
</Base>
