---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("notes");
for (const entry of all) assertReadableSlug(entry.id, "Notes");

const notes = all
  .filter(isLive)
  .sort((a, b) => b.data.order - a.data.order || a.data.title.localeCompare(b.data.title));
---

<Base title="Notes" page="notes" current="notes" description="Notes.">
  <Section num="05" title="Notes" />
  <ul class="note-list">
    {
      notes.map((entry) => (
        <li>
          <a href={`/notes/${entry.id}/`}>{entry.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
