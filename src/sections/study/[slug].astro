---
import { getCollection, render } from "astro:content";
import EntryArticle from "../../components/EntryArticle.astro";
import Pager from "../../components/Pager.astro";
import SetPage from "../../components/SetPage.astro";
import { byOrder, hasNote, isLive, neighbours } from "../../lib/content";
import { formatRange } from "../../lib/dates";
import { loadSeries } from "../../lib/series";
import { assertReadableSlug } from "../../lib/slugs";
import { sectionMeta } from "../../site.sections";

export async function getStaticPaths() {
  const roles = await getCollection("study");
  for (const entry of roles) assertReadableSlug(entry.id, "Study");
  const items = byOrder(roles.filter(isLive));
  const sets = await loadSeries(
    "study",
    roles.map((entry) => entry.id),
  );
  return [
    ...items.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "item" as const, entry },
    })),
    ...sets.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "set" as const, entry },
    })),
  ];
}

const props = Astro.props;
const entry = props.kind === "item" ? props.entry : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const items = byOrder((await getCollection("study")).filter(isLive));
const { newer, older } = entry ? neighbours(items, entry.id) : { newer: undefined, older: undefined };
---

{
  props.kind === "set" && <SetPage entry={props.entry} />
}
{
  entry && (
    <EntryArticle
      page="entry study"
      current="study"
      title={entry.data.title}
      description={entry.data.summary}
      kickerHref={sectionMeta.study.href}
      kicker="study"
      meta={[formatRange(entry.data.start, entry.data.end)]}
    >
      {hasNote(entry) && Content ? <Content /> : <p>{entry.data.summary}</p>}
      <Pager
        slot="pager"
        indexHref={sectionMeta.study.href}
        indexLabel="all study"
        newer={newer ? { href: `/study/${newer.id}/`, label: "newer" } : undefined}
        older={older ? { href: `/study/${older.id}/`, label: "older" } : undefined}
      />
    </EntryArticle>
  )
}
