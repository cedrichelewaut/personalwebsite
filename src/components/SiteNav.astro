---
import { navItems } from "../site";

interface Props {
  current: string;
  narrow?: boolean;
}

const { current, narrow = false } = Astro.props;

const active: Record<string, string> = {
  index: "home",
  home: "home",
  experience: "experience",
  work: "experience",
  study: "experience",
  personal: "personal",
  projects: "personal",
  photographs: "personal",
  reading: "personal",
  running: "personal",
  blog: "personal",
  contact: "contact",
};

const here = active[current] ?? current;
---

<nav class:list={["site-nav", narrow && "site-nav-narrow"]} aria-label="Sections">
  <ul class="nav-links">
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.id === here ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
