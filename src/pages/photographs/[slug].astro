---
import Base from "../../layouts/Base.astro";
import SetPage from "../../components/SetPage.astro";
import photos from "../../data/photographs.json";
import { figCaption } from "../../lib/figures";
import { loadSeries } from "../../lib/series";

export async function getStaticPaths() {
  const sets = await loadSeries(
    "photographs",
    photos.map((photo) => photo.slug),
  );
  return [
    ...photos.map((photo, index) => ({
      params: { slug: photo.slug },
      props: { kind: "photo" as const, photo, index },
    })),
    ...sets.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "set" as const, entry },
    })),
  ];
}

const props = Astro.props;
const caption =
  props.kind === "photo" ? figCaption(props.index + 1, props.photo.place, props.photo.date) : "";
---

{
  props.kind === "set" ? (
    <SetPage entry={props.entry} />
  ) : (
    <Base title={props.photo.title} page="entry photographs" current="photographs" description={caption}>
        <div class="grid head">
          <p class="section-no">04</p>
          <div class="head-copy">
            <p class="kicker">
              <a href="/photographs/">photographs</a>
            </p>
            <h1>{props.photo.title}</h1>
            <p class="dek">{caption}</p>
          </div>
        </div>
        <figure class="plate">
          <a href={props.photo.src}>
            <img src={props.photo.src} width={props.photo.width} height={props.photo.height} alt={props.photo.alt} />
          </a>
          <figcaption>
            <span>{caption}</span>
            {props.photo.note && <span class="cap-note">{props.photo.note}</span>}
          </figcaption>
        </figure>
        <p class="block pager">
          <a href={`/photographs/#${props.photo.slug}`}>all photographs</a>
        </p>
    </Base>
  )
}
