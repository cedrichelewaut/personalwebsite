---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import TitleList from "../../components/TitleList.astro";
import { sections } from "../../site";
import { sectionMeta } from "../../site.sections";
import photos from "../../data/photographs.json";
import { byOrder, isLive } from "../../lib/content";

const projects = sections.projects ? byOrder((await getCollection("projects")).filter(isLive)) : [];
const posts = sections.blog ? byOrder((await getCollection("blog")).filter(isLive)) : [];
---

<Base
  title="Personal Projects"
  page="personal"
  current="personal"
  description="Projects, photographs, and reading."
>
  <div class="grid head">
    <div class="head-copy span-all">
      <h1>Personal Projects</h1>
    </div>
  </div>
  {
    sections.projects && (
      <section class="digest" aria-labelledby="personal-projects">
        <h2 class="digest-title" id="personal-projects">
          <a href={sectionMeta.projects.href}>{sectionMeta.projects.label}</a>
        </h2>
        <TitleList items={projects.map((entry) => ({ href: `/projects/${entry.id}/`, title: entry.data.title }))} />
      </section>
    )
  }
  {
    sections.photos && (
      <section class="digest" aria-labelledby="personal-photos">
        <h2 class="digest-title" id="personal-photos">
          <a href={sectionMeta.photos.href}>{sectionMeta.photos.label}</a>
        </h2>
        <TitleList items={photos.map((photo) => ({ href: `/photographs/${photo.slug}/`, title: photo.title }))} />
      </section>
    )
  }
  {
    sections.bookshelf && (
      <section class="digest" aria-labelledby="personal-reading">
        <h2 class="digest-title" id="personal-reading">
          <a href={sectionMeta.bookshelf.href}>{sectionMeta.bookshelf.label}</a>
        </h2>
        <p class="lede">
          <a href="/reading/">Bookshelf</a>
        </p>
      </section>
    )
  }
  {
    sections.running && (
      <section class="digest" aria-labelledby="personal-running">
        <h2 class="digest-title" id="personal-running">
          <a href={sectionMeta.running.href}>{sectionMeta.running.label}</a>
        </h2>
        <p class="lede">Currently training for Hamburg Marathon 2027. Progress so far:</p>
      </section>
    )
  }
  {
    sections.blog && (
      <section class="digest" aria-labelledby="personal-blog">
        <h2 class="digest-title" id="personal-blog">
          <a href={sectionMeta.blog.href}>{sectionMeta.blog.label}</a>
        </h2>
        <TitleList items={posts.map((entry) => ({ href: `/blog/${entry.id}/`, title: entry.data.title }))} />
      </section>
    )
  }
</Base>
