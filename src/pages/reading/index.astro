---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import BookPoster from "../../components/BookPoster.astro";
import NowReading from "../../components/NowReading.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { isLive } from "../../lib/content";
import { loadCurrent } from "../../lib/current";
import { readSortKey } from "../../lib/dates";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("reading");
for (const entry of all) assertReadableSlug(entry.id, "Books");

const books = all.filter(isLive).sort((a, b) => {
  const byDate = readSortKey(b.data.read) - readSortKey(a.data.read);
  if (byDate !== 0) return byDate;
  return a.data.title.localeCompare(b.data.title);
});

const current = await loadCurrent();
---

<Base
  title="Reading"
  page="reading"
  current="reading"
  description="The book Cedric is reading now, and a short list of the books he recommends most."
>
  <Section num="05" title="Reading" />
  <CollectionIndex section="reading" reserved={all.map((entry) => entry.id)} />
  <NowReading
    title={current.data.title}
    author={current.data.author}
    edition={current.data.edition}
    url={current.data.url}
    lang={current.data.lang}
  />
  <section class="part" aria-labelledby="recommendations">
    <h2 class="part-title" id="recommendations">Latest recommendations</h2>
    <p class="lede">A short list of the books I recommend most.</p>
    <BookPoster books={books} />
  </section>
</Base>
