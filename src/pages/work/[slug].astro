---
import { getCollection, render } from "astro:content";
import Note from "../../layouts/Note.astro";
import Pager from "../../components/Pager.astro";
import SetPage from "../../components/SetPage.astro";
import { byOrder, hasNote, isLive, neighbours } from "../../lib/content";
import { formatRange } from "../../lib/dates";
import { loadSeries } from "../../lib/series";

export async function getStaticPaths() {
  const roles = await getCollection("work");
  const notes = byOrder(roles.filter((entry) => isLive(entry) && hasNote(entry)));
  const sets = await loadSeries(
    "work",
    roles.map((entry) => entry.id),
  );
  return [
    ...notes.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "role" as const, entry },
    })),
    ...sets.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "set" as const, entry },
    })),
  ];
}

const props = Astro.props;
const entry = props.kind === "role" ? props.entry : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const notes = byOrder((await getCollection("work")).filter((item) => isLive(item) && hasNote(item)));
const { newer, older } = entry ? neighbours(notes, entry.id) : { newer: undefined, older: undefined };
const meta = entry
  ? [
      { label: "dates", value: formatRange(entry.data.start, entry.data.end) },
      { label: "organisation", value: entry.data.org },
    ]
  : [];
---

{
  props.kind === "set" && <SetPage entry={props.entry} />
}
{
  entry && Content && (
<Note
  page="entry work"
  current="work"
  section="01"
  title={entry.data.title}
  description={entry.data.summary}
  kickerHref="/work/"
  kicker="work"
  dek={entry.data.subtitle}
  meta={meta}
>
  {
    entry.data.figure && (
      <figure class="figure">
        <img src={entry.data.figure.src} alt={entry.data.figure.alt} />
        <figcaption>{entry.data.figure.caption}</figcaption>
      </figure>
    )
  }
  <Content />
  <Pager
    slot="pager"
    indexHref="/work/"
    indexLabel="all work"
    newer={newer ? { href: `/work/${newer.id}/`, label: "newer" } : undefined}
    older={older ? { href: `/work/${older.id}/`, label: "older" } : undefined}
  />
</Note>
  )
}
