---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TitleList from "../components/TitleList.astro";
import CollectionIndex from "../components/CollectionIndex.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import RunningProgress from "../components/RunningProgress.astro";
import { site, sections } from "../site";
import { sectionMeta } from "../site.sections";
import { byOrder, isLive } from "../lib/content";
import { byAlbumDate } from "../lib/photography";
import { assertReadableSlug } from "../lib/slugs";

const workAll = sections.work ? await getCollection("work") : [];
const studyAll = sections.study ? await getCollection("study") : [];
const projectAll = sections.projects ? await getCollection("projects") : [];
const postAll = sections.blog ? await getCollection("blog") : [];
const albumAll = sections.photos ? await getCollection("photography") : [];
for (const entry of workAll) assertReadableSlug(entry.id, "Roles");
for (const entry of studyAll) assertReadableSlug(entry.id, "Study");
for (const entry of projectAll) assertReadableSlug(entry.id, "Projects");
for (const entry of postAll) assertReadableSlug(entry.id, "Posts");
for (const entry of albumAll) assertReadableSlug(entry.id, "Albums");

const work = byOrder(workAll.filter(isLive));
const study = byOrder(studyAll.filter(isLive));
const projects = byOrder(projectAll.filter(isLive));
const posts = byOrder(postAll.filter(isLive));
const albums = byAlbumDate(albumAll.filter(isLive));

const BookshelfExcerpt = sections.bookshelf
  ? (await import("../personal/bookshelf/BookshelfExcerpt.astro")).default
  : null;

const showExperience = sections.work || sections.study;
const icons: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" />',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />',
  instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />',
};
---

<Base title={site.name} page="home" current="index" description={sections.intro ? site.intro : site.description}>
  {
    sections.intro && (
      <header slot="lead" class="intro" id="intro">
        <div class="intro-photo">
          <img
            src={site.portrait.src}
            alt={site.portrait.alt}
            width={site.portrait.width}
            height={site.portrait.height}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="intro-text">
          <h1 class="sr-only">{site.name}</h1>
          <p class="intro-copy">
            <span class="hl">{site.intro}</span>
          </p>
          {sections.contact && (
            <p class="intro-contact">
              <a class="pill" href={site.contactLink.href}>
                {site.contactLink.label}
              </a>
            </p>
          )}
        </div>
      </header>
    )
  }

  {
    showExperience && (
      <section class="digest" id="experience" aria-labelledby="experience-title">
        <h2 class="digest-title" id="experience-title">
          Experience
        </h2>
        {sections.work && (
          <section class="sub" id="work" aria-labelledby="work-title">
            <h3 class="sub-title" id="work-title">
              {sectionMeta.work.label}
            </h3>
            <CollectionIndex section="work" reserved={workAll.map((entry) => entry.id)} />
            <TitleList items={work.map((entry) => ({ href: `/work/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
        {sections.study && (
          <section class="sub" id="study" aria-labelledby="study-title">
            <h3 class="sub-title" id="study-title">
              {sectionMeta.study.label}
            </h3>
            <CollectionIndex section="study" reserved={studyAll.map((entry) => entry.id)} />
            <TitleList items={study.map((entry) => ({ href: `/study/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
      </section>
    )
  }

  {
    sections.projects && (
      <section class="digest" id="projects" aria-labelledby="projects-title">
        <h2 class="digest-title" id="projects-title">
          {sectionMeta.projects.label}
        </h2>
        <CollectionIndex section="projects" reserved={projectAll.map((entry) => entry.id)} />
        <TitleList items={projects.map((entry) => ({ href: `/projects/${entry.id}/`, title: entry.data.title }))} />
      </section>
    )
  }

  {
    sections.photos && albums.length > 0 && (
      <section class="digest" id="photography" aria-labelledby="photography-title">
        <h2 class="digest-title" id="photography-title">
          {sectionMeta.photos.label}
        </h2>
        <PhotoCarousel albums={albums} />
      </section>
    )
  }

  {BookshelfExcerpt && <BookshelfExcerpt />}

  {
    sections.running && (
      <section class="digest" id="running" aria-labelledby="running-title">
        <h2 class="digest-title" id="running-title">
          {sectionMeta.running.label}
        </h2>
        <p class="lede">Currently training for Hamburg Marathon 2027. Progress so far:</p>
        <RunningProgress />
        <p class="board-link">
          <a href={site.runningBoard} target="_blank" rel="noopener noreferrer">
            Full schedule →
          </a>
        </p>
        <p class="lede">Training schema inspired by Advanced Marathoning (Pfitzinger &amp; Douglas).</p>
      </section>
    )
  }

  {
    sections.blog && (
      <section class="digest" id="blog" aria-labelledby="blog-title">
        <h2 class="digest-title" id="blog-title">
          {sectionMeta.blog.label}
        </h2>
        <TitleList items={posts.map((entry) => ({ href: `/blog/${entry.id}/`, title: entry.data.title }))} />
      </section>
    )
  }

  {
    sections.contact && (
      <section class="digest" id="contact" aria-labelledby="contact-title">
        <h2 class="digest-title" id="contact-title">
          Contact
        </h2>
        <p class="lede">
          Open for questions, business inquiries, or just grabbing a coffee. Get in touch through this form
          or on LinkedIn!
        </p>
        <form class="contact-form" action={site.formspree} method="POST">
          <input type="hidden" name="_subject" value="Website — Cedric Helewaut" />
          <p class="hp">
            <label for="gotcha">Leave this empty</label>
            <input id="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </p>
          <div class="field">
            <label for="name">name</label>
            <input id="name" type="text" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">email</label>
            <input id="email" type="email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="message">message</label>
            <textarea id="message" name="message" rows="3" required></textarea>
          </div>
          <button class="submit" type="submit">send message</button>
          <p class="form-note">
            Your details are used only to reply. See the <a href="/privacy/">privacy notice</a>.
          </p>
        </form>
        <ul class="social">
          {site.profiles.map((profile) => {
            const external = profile.href.startsWith("http");
            return (
              <li>
                <a
                  class="circle"
                  href={profile.href}
                  aria-label={profile.label}
                  title={profile.label}
                  rel={external ? "me noopener noreferrer" : "me"}
                  target={external ? "_blank" : undefined}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[profile.label.toLowerCase()] ?? ""} />
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Base>
