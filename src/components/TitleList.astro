---
interface Item {
  href: string;
  title: string;
  children?: Item[];
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="note-list">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>{item.title}</a>
        {item.children && item.children.length > 0 && (
          <ul class="note-sublist">
            {item.children.map((child) => (
              <li>
                <a href={child.href}>{child.title}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
