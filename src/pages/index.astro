---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TitleList from "../components/TitleList.astro";
import { site, sections } from "../site";
import { sectionMeta } from "../site.sections";
import photos from "../data/photographs.json";
import { byOrder, isLive } from "../lib/content";
import { figCaption } from "../lib/figures";

const latestCount = 3;

const work = sections.work ? byOrder((await getCollection("work")).filter(isLive)).slice(0, latestCount) : [];
const study = sections.study ? byOrder((await getCollection("study")).filter(isLive)).slice(0, latestCount) : [];
const projects = sections.projects
  ? byOrder((await getCollection("projects")).filter(isLive)).slice(0, latestCount)
  : [];
const posts = sections.blog ? byOrder((await getCollection("blog")).filter(isLive)).slice(0, latestCount) : [];

const BookshelfExcerpt = sections.bookshelf
  ? (await import("../personal/bookshelf/BookshelfExcerpt.astro")).default
  : null;

const plates = sections.photos
  ? photos.slice(0, latestCount).map((photo, index) => ({
      ...photo,
      caption: figCaption(index + 1, photo.place, photo.date),
    }))
  : [];

const showExperience = sections.work || sections.study;
const showPersonal = sections.projects || sections.photos || sections.bookshelf || sections.running || sections.blog;
---

<Base title={site.name} page="home" current="index" description={sections.intro ? site.intro : site.description}>
  {
    sections.intro && (
      <header slot="lead" class="intro" id="intro">
        <div class="intro-photo">
          <img
            src={site.portrait.src}
            alt={site.portrait.alt}
            width={site.portrait.width}
            height={site.portrait.height}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="intro-text">
          <h1 class="intro-title">
            <span class="hl">{site.name}</span>
          </h1>
          <p class="intro-copy">
            <span class="hl">{site.intro}</span>
          </p>
          {sections.contact && (
            <p class="intro-contact">
              <a class="hl" href={site.contactLink.href}>
                {site.contactLink.label}
              </a>
            </p>
          )}
        </div>
      </header>
    )
  }

  {
    showExperience && (
      <section class="home-group" aria-labelledby="home-experience">
        <h2 class="home-group-title" id="home-experience">
          Experience
        </h2>
        {sections.work && (
          <section class="digest" aria-labelledby="home-work">
            <h3 class="digest-title" id="home-work">
              <a href={sectionMeta.work.href}>{sectionMeta.work.label}</a>
            </h3>
            <TitleList items={work.map((entry) => ({ href: `/work/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
        {sections.study && (
          <section class="digest" aria-labelledby="home-study">
            <h3 class="digest-title" id="home-study">
              <a href={sectionMeta.study.href}>{sectionMeta.study.label}</a>
            </h3>
            <TitleList items={study.map((entry) => ({ href: `/study/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
      </section>
    )
  }

  {
    showPersonal && (
      <section class="home-group" aria-labelledby="home-personal">
        <h2 class="home-group-title" id="home-personal">
          Personal Projects
        </h2>
        {sections.projects && (
          <section class="digest" aria-labelledby="home-projects">
            <h3 class="digest-title" id="home-projects">
              <a href={sectionMeta.projects.href}>{sectionMeta.projects.label}</a>
            </h3>
            <TitleList items={projects.map((entry) => ({ href: `/projects/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
        {sections.photos && (
          <section class="digest" aria-labelledby="home-photographs">
            <h3 class="digest-title" id="home-photographs">
              <a href={sectionMeta.photos.href}>{sectionMeta.photos.label}</a>
            </h3>
            <div class="grid thumbs">
              {plates.map((photo) => (
                <a class="thumb" href={`/photographs/${photo.slug}/`}>
                  <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} />
                  <span class="thumb-label">{photo.caption}</span>
                </a>
              ))}
            </div>
          </section>
        )}
        {BookshelfExcerpt && <BookshelfExcerpt />}
        {sections.running && (
          <section class="digest" aria-labelledby="home-running">
            <h3 class="digest-title" id="home-running">
              <a href={sectionMeta.running.href}>{sectionMeta.running.label}</a>
            </h3>
            <p class="lede">Currently training for Hamburg Marathon 2027. Progress so far:</p>
          </section>
        )}
        {sections.blog && (
          <section class="digest" aria-labelledby="home-blog">
            <h3 class="digest-title" id="home-blog">
              <a href={sectionMeta.blog.href}>{sectionMeta.blog.label}</a>
            </h3>
            <TitleList items={posts.map((entry) => ({ href: `/blog/${entry.id}/`, title: entry.data.title }))} />
          </section>
        )}
      </section>
    )
  }
</Base>
