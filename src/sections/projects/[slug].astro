---
import { getCollection, render } from "astro:content";
import EntryArticle from "../../components/EntryArticle.astro";
import LockedPage from "../../components/LockedPage.astro";
import RunningProgress from "../../components/RunningProgress.astro";
import SetPage from "../../components/SetPage.astro";
import { byOrder, hasNote, isLive } from "../../lib/content";
import { formatRange } from "../../lib/dates";
import { loadSeries } from "../../lib/series";
import { assertReadableSlug } from "../../lib/slugs";
import { site } from "../../site";

export async function getStaticPaths() {
  const all = await getCollection("projects");
  for (const entry of all) assertReadableSlug(entry.id, "Projects");
  const items = byOrder(all.filter(isLive));
  const sets = await loadSeries(
    "projects",
    all.map((entry) => entry.id),
  );
  return [
    ...items.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "item" as const, entry },
    })),
    ...sets.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "set" as const, entry },
    })),
  ];
}

const props = Astro.props;
const entry = props.kind === "item" ? props.entry : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const link = entry?.data.url?.trim() ?? "";
const dates =
  entry?.data.start && entry?.data.end ? formatRange(entry.data.start, entry.data.end) : "";
---

{
  props.kind === "set" && <SetPage entry={props.entry} />
}
{
  entry && entry.data.locked && <LockedPage slug={entry.id} title={entry.data.title} />
}
{
  entry && !entry.data.locked && (
    <EntryArticle
      page="entry projects"
      title={entry.data.title}
      description={entry.data.summary}
      meta={dates ? [dates] : []}
      link={link}
    >
      {hasNote(entry) && Content ? <Content /> : <p>{entry.data.summary}</p>}
      {entry.data.embed === "running" && (
        <>
          <RunningProgress />
          <p class="board-link">
            <a href={site.runningBoard} target="_blank" rel="noopener noreferrer">Full schedule →</a>
          </p>
        </>
      )}
    </EntryArticle>
  )
}
