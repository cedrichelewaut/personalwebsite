---
import { getCollection, render } from "astro:content";
import Collage from "../../components/Collage.astro";
import Base from "../../layouts/Base.astro";
import { hasNote, isLive } from "../../lib/content";
import { albumImages, byAlbumDate, photoCaption } from "../../lib/photography";
import { assertReadableSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const all = await getCollection("photography");
  for (const entry of all) assertReadableSlug(entry.id, "Albums");
  return byAlbumDate(all.filter(isLive)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const images = albumImages(entry.id);
---

<Base title={entry.data.title} description={entry.data.title} page="entry photography" current="" ogType="article">
  <header class="article-head">
    <h1>{entry.data.title}</h1>
  </header>
  {
    hasNote(entry) && (
      <div class="prose article">
        <Content />
      </div>
    )
  }
  <Collage images={images} caption={photoCaption} />
</Base>
