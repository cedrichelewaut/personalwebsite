---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { isLive } from "../../lib/content";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("writing");
for (const entry of all) assertReadableSlug(entry.id, "Essays");

const essays = all
  .filter(isLive)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<Base title="Writing" page="writing" current="writing" description="Essays.">
  <Section num="05" title="Writing" />
  <ul class="essays">
    {
      essays.map((entry) => (
        <li>
          <a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
