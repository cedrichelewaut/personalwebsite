---
import { existsSync } from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import photos from "../../data/photographs.json";
import { figCaption } from "../../lib/figures";
import { assertReadableSlug } from "../../lib/slugs";

const seen = new Set<string>();
for (const photo of photos) {
  assertReadableSlug(photo.slug, "Photographs");
  if (seen.has(photo.slug)) throw new Error(`Duplicate photograph slug: ${photo.slug}.`);
  seen.add(photo.slug);
  const file = path.join(process.cwd(), "public", photo.src);
  if (!existsSync(file)) throw new Error(`Missing photograph file: ${photo.src}`);
}

const plates = photos.map((photo, index) => ({
  ...photo,
  caption: figCaption(index + 1, photo.place, photo.date),
}));
---

<Base
  title="Photography"
  page="photographs"
  current="photographs"
  description="Photography carried over from the previous site."
>
  <Section num="04" title="Photography">
    <p class="lede">
      Plates carried over from the previous site. A place is named only when the file name recorded it.
      The square index jumps to the plate.
    </p>
  </Section>
  <CollectionIndex section="photographs" reserved={photos.map((photo) => photo.slug)} />
  <div class="grid thumbs">
    {
      plates.map((photo) => (
        <a class="thumb" href={`#${photo.slug}`} aria-label={photo.caption}>
          <img src={photo.src} alt="" width={photo.width} height={photo.height} />
          <span class="thumb-label">{photo.title}</span>
        </a>
      ))
    }
  </div>
  {
    plates.map((photo) => (
      <figure class="plate" id={photo.slug}>
        <a href={photo.src}>
          <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} />
        </a>
        <figcaption>
          <a href={`/photographs/${photo.slug}/`}>{photo.caption}</a>
          {photo.note && <span class="cap-note">{photo.note}</span>}
        </figcaption>
      </figure>
    ))
  }
</Base>
