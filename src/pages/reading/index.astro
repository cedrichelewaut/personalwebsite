---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import IndexTable from "../../components/IndexTable.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { hasNote, isLive } from "../../lib/content";
import { formatRead, readSortKey } from "../../lib/dates";
import { assertReadableSlug } from "../../lib/slugs";

const all = await getCollection("reading");
for (const entry of all) assertReadableSlug(entry.id, "Books");

const books = all.filter(isLive).sort((a, b) => {
  const byDate = readSortKey(b.data.read) - readSortKey(a.data.read);
  if (byDate !== 0) return byDate;
  return a.data.title.localeCompare(b.data.title);
});

const showNote = books.some((book) => book.data.summary.trim().length > 0);
const rows = books.map((entry) => ({
  cells: {
    dates: formatRead(entry.data.read),
    title: entry.data.title,
    author: entry.data.author,
    ...(showNote ? { note: entry.data.summary } : {}),
  },
  href: hasNote(entry) ? `/reading/${entry.id}/` : undefined,
  linkKey: "title",
  flag: entry.data.highly ? "highly recommended" : undefined,
}));
---

<Base
  title="Reading"
  page="reading"
  current="reading"
  description="Books Cedric recommends, drawn from what he has read. Not reviews."
>
  <Section num="04" title="Reading">
    <p class="lede">Books I recommend, drawn from what I have read. Not reviews.</p>
  </Section>
  <CollectionIndex section="reading" reserved={all.map((entry) => entry.id)} />
  <IndexTable
    columns={[
      { key: "dates", label: "read" },
      { key: "title", label: "title" },
      { key: "author", label: "author" },
      ...(showNote ? [{ key: "note", label: "note" }] : []),
    ]}
    rows={rows}
  />
</Base>
